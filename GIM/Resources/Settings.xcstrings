    "settings.account.recoveryKeyBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery key is a spare key that brings your account back on a new device. Keep it somewhere safe and private."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave de recuperación es una llave de repuesto que recupera tu cuenta en un dispositivo nuevo. Guárdala en un lugar seguro y privado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复密钥是一把备用钥匙，能在新设备上找回你的账号。请把它存放在安全、私密的地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原金鑰是一把備用鑰匙，能在新裝置上找回你的帳號。請把它存放在安全、私密的地方。"
          }
        }
      }
    },
    "settings.account.recoveryKeyTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery key"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave de recuperación"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的恢复密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的復原金鑰"
          }
        }
      }
    },
