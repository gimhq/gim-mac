    "settings.keep.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backs up your privacy settings and receives the reports you send. Your backup is encrypted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace una copia de seguridad de tu configuración de privacidad y recibe los informes que envías. Tu copia de seguridad está cifrada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份你的隐私设置，并接收你发送的报告。你的备份已加密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份你的隱私設定，並接收你傳送的報告。你的備份已加密。"
          }
        }
      }
    },
