    "settings.about.licences": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "gim is built with Swift, SwiftUI and GIMKit. Third-party licences ship with the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "gim está hecho con Swift, SwiftUI y GIMKit. Las licencias de terceros vienen con la app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "gim 使用 Swift、SwiftUI 和 GIMKit 构建。第三方许可随 App 一起提供。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "gim 使用 Swift、SwiftUI 和 GIMKit 打造。第三方授權隨 App 一起提供。"
