        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará su sesión y no podrá leer mensajes nuevos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会被退出登录，并且无法读取新消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會被登出，而且無法讀取新訊息。"
          }
