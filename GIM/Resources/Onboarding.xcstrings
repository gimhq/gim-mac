    "onboarding.kit.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a spare key to your account. If you lose all your devices, your Account ID and recovery key get your account back. Keep them secret. You see them only now, so save them somewhere safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una llave de repuesto de tu cuenta. Si pierdes todos tus dispositivos, tu ID de cuenta y tu clave de recuperación te devuelven tu cuenta. Mantenlos en secreto. Solo los ves ahora, así que guárdalos en un lugar seguro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是你账号的备用钥匙。如果你的设备全丢了，账号 ID 和恢复密钥能帮你找回账号。请保密。它们只显示这一次，请保存在安全的地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是你帳號的備用鑰匙。如果你的裝置全都遺失了，帳號 ID 和復原金鑰能幫你找回帳號。請保密。它們只會顯示這一次，請存放在安全的地方。"
          }
        }
      }
    },
    "onboarding.kit.checkBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the last 4 characters of your recovery key. This makes sure you saved it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe los últimos 4 caracteres de tu clave de recuperación. Así nos aseguramos de que la guardaste."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入恢复密钥的最后 4 个字符。这样可以确认你已经保存好了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入復原金鑰的最後 4 個字元。這樣可以確認你已經存好了。"
          }
        }
      }
    },
    "onboarding.kit.checkError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn’t match. Look at your recovery key and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No coincide. Mira tu clave de recuperación e inténtalo de nuevo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不匹配。请看一下你的恢复密钥，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不相符。請看一下你的復原金鑰，然後再試一次。"
          }
        }
      }
    },
    "onboarding.kit.checkLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last 4 characters"
          }
        },
