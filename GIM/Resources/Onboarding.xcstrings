    "onboarding.kit.accountId": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account ID"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ID de cuenta"
          }
        },
        "zh-Hans": {
          "stringUnit": {
