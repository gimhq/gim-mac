    "onboarding.link.compareBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your other device shows a code too. Choose “The codes match” only if both are the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu otro dispositivo también muestra un código. Elige “Los códigos coinciden” solo si los dos son iguales."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的另一台设备也会显示一个代码。只有两个代码完全相同时，才选择“代码一致”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的另一台裝置也會顯示一組代碼。只有兩組代碼完全相同時，才選擇“代碼相符”。"
          }
        }
      }
    },
    "onboarding.link.compareTitle": {
      "extractionState": "manual",
