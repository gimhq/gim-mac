    "onboarding.restore.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the recovery kit you saved when you made your account. Old chats don't come back. Friends need to add you to groups again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el kit de recuperación que guardaste al crear tu cuenta. Los chats antiguos no vuelven. Tus amigos tendrán que volver a añadirte a los grupos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你创建账号时保存的恢复套件。以前的聊天不会回来。朋友需要重新把你加入群组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你建立帳號時儲存的復原套件。以前的聊天不會回來。朋友需要重新把你加入群組。"
          }
        }
      }
    },
