    "onboarding.kit.fileNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this secret. Anyone who has it can get into your account. Lost all your devices? Open gim, choose “Restore with your recovery kit” and paste this text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenlo en secreto. Cualquiera que lo tenga puede entrar en tu cuenta. ¿Perdiste todos tus dispositivos? Abre gim, elige “Restaurar con tu kit de recuperación” y pega este texto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保密。任何拿到它的人都能进入你的账号。设备全丢了？打开 gim，选择“用恢复套件恢复”，然后粘贴这段文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保密。任何拿到它的人都能進入你的帳號。裝置全都遺失了？打開 gim，選擇“使用復原套件復原”，然後貼上這段文字。"
          }
        }
      }
    },
