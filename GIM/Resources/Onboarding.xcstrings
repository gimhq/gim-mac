    "onboarding.create.nameBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People see this name in your chats. You can change it later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las personas ven este nombre en tus chats. Puedes cambiarlo más tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别人会在聊天中看到这个名字。你以后可以修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "別人會在聊天中看到這個名稱。你之後可以更改。"
          }
        }
      }
    },
